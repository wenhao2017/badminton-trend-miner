APP_ENV=local
WEB_AUTH_ENABLED=true
WEB_AUTH_USERNAME=admin
WEB_AUTH_PASSWORD=change_this_password
WEB_SESSION_SECRET=change_this_long_random_secret
DATABASE_URL=sqlite:///data/badminton.sqlite3

SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_API_KEYS=
SPORTRADAR_KEY_QPS=1
SPORTRADAR_KEY_TOTAL_QUOTA=1000
SPORTRADAR_LIVE_CACHE_TTL_SECONDS=20

ENABLE_JOB_WORKER=true
ENABLE_LIVE_MONITOR=false
ENABLE_DAILY_HISTORY_IMPORT=false
LIVE_MONITOR_SCHEDULE_ENABLED=true
LIVE_MONITOR_INTERVAL_SECONDS=60
LIVE_SIGNAL_MAX_AGE_SECONDS=60
ENABLE_ADAPTIVE_LIVE_POLLING=false
LIVE_POLL_EXTRA_REQUESTS_PER_DAY=100

OFFICIAL_S_ENABLED=false
SIGNAL_COMPETITION_IDS=
MATCH_S_LEVEL_THRESHOLD=0.85
S_CONFIRMATION_TREND_THRESHOLD=0.70
MIN_PRIOR_MATCHES_FOR_S=10
MIN_POINTS_FOR_SIGNAL=12
MODEL_MAX_TRAINING_SAMPLES=0

ENABLE_TELEGRAM_ALERT=false
ENABLE_EMAIL_ALERT=false
ENABLE_SLACK_ALERT=false

