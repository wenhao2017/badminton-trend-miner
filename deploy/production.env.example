APP_ENV=production
WEB_AUTH_ENABLED=true
WEB_AUTH_USERNAME=admin
WEB_MANAGE_SPORTRADAR_KEYS=false
WEB_SESSION_TTL_SECONDS=28800
DATABASE_URL=sqlite:////var/lib/badminton-trend-miner/data/badminton.sqlite3
MODEL_DIRECTORY=/var/lib/badminton-trend-miner/models
MODEL_MAX_TRAINING_SAMPLES=30000
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_API_KEYS=
ENABLE_JOB_WORKER=true
ENABLE_LIVE_MONITOR=false
ENABLE_DAILY_HISTORY_IMPORT=false
ENABLE_ADAPTIVE_LIVE_POLLING=false
OFFICIAL_S_ENABLED=false
OFFICIAL_S_21_POLICY=legacy
ENABLE_TELEGRAM_ALERT=false
ENABLE_SLACK_ALERT=false
ENABLE_EMAIL_ALERT=false
ENABLE_DAILY_EMAIL_REPORT=false
