[Unit]
Description=Badminton Trend Miner SQLite and model backup
After=badminton-trend-miner.service
ConditionPathExists=/var/lib/badminton-trend-miner/data/badminton.sqlite3

[Service]
Type=oneshot
User=badminton
Group=badminton
WorkingDirectory=/opt/badminton-trend-miner/current
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/badminton-trend-miner/current/.venv/bin/python deploy/backup.py
Nice=10
IOSchedulingClass=idle
MemoryMax=128M
CPUQuota=35%
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/badminton-trend-miner
